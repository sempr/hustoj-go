# judge 数据库连接配置（systemd EnvironmentFile 注入）。
#
# 安装位置：/home/judge/etc/judge.conf
# 权限建议：root:root 0600（内容含 DB 凭据，systemd 以 PID 1 读取后降权执行，
# 因此无需为 www-data 放宽权限）。
#
# Web 服务（hustoj web）与判题守护进程（hustoj daemon）都从这里取数据库凭据。
# 首次部署时把它复制成 judge.conf 并填入真实值，不要提交进版本库。

OJ_HOST_NAME=localhost
OJ_PORT_NUMBER=3306
OJ_USER_NAME=hustoj
OJ_PASSWORD=change-me
OJ_DB_NAME=hustoj
# 判题受理语言 id（逗号分隔）。安装语言运行时的 install_langs.sh 会按实际
# 安装的 <id>.lang.toml 自动重写这一行；这里给默认的 C/C++/Python。
OJ_LANG_SET=0,1,6

# 通讯题（spj=4）每组数据允许的最大运行轮数，默认 10。
# 只用于挡住写错而无限出题的校验器：正常题目由校验器自己决定何时结束
# （不再写 nextpass.in）。题目确实需要更多轮（例如二分 10^9 约需 30 轮）
# 时调大即可，写小了会让正确程序在第 N 轮被判 WA。
OJ_COMMUNICATION_MAX_PASSES=10
