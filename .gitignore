cversion/**
old/**

# 构建产物（Phase 0 起主二进制更名为 hustoj，hustoj-go 为过渡期名称）
hustoj
hustoj-go
tini/tini
tini/tini-static

# make dist 产出的离线部署包
dist/

# 本地调试日志（manual judge / cgroup 调试产生）
*.log

# make check-versions 输出
versions.txt

internal/sandbox/zz_test.go

# 遗留 PHP 前端（web 切割完成后只作参照，运行副本在
# /home/judge/src/web；其 db_info.inc.php 含真实 DB 账密，
# 不得入库）
phpweb/

# Go Web 本地配置（含运营参数，站点身份不入库）
*.local.toml
web.toml

# 独立仓库（自带 .git，remote github.com/sempr/hustoj-go-interactive.git）。
# 若提交进本仓库只会变成 gitlink，clone 后目录为空导致构建失败；
# 它是参照用的外部项目，不是本仓库源码。
hustoj-go-interactive/

# 一次性排查 CSRF 时的临时探针；check_all.sh 引用的是 test_csrf.php
extra/_csrf_probe.php

# tests/ 下的判题程序编译产物（源码 *.rs / *.py / spj 源码均入库，
# 需按 Makefile 重新编译；11MB 且带 debug_info，不应进版本库）
tests/rs/1

# 语言 rootfs 拍平产物（build_rootfs.sh / prepare_langs.sh 生成，机器相关，不入库）
extra/var/rootfs/

# 本地 agent 工具配置（会话级，不属于项目源码）
.commandcode/

# Python 字节码缓存（extra/schema_diff.py 会 import check_schema）
__pycache__/
*.pyc
